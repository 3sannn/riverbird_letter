{
    "name": "riverbird/letter-portal",
    "description": "RiverBird document management portal",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php database/migrate.php"
    },
    "config": {
        "sort-packages": true
    }
}
