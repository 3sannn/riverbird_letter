APP_NAME="RiverBird Letter"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

# Web document root should point to /public (or map public/* to public_html on Hostinger)
PUBLIC_PATH=public

# Paths relative to project root unless absolute
STORAGE_PATH=storage
TEMPLATE_PATH=templates

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riverbird_letter
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

UPLOAD_MAX_BYTES=10485760

COMPANY_NAME="RiverBird Digital Solutions Pvt Ltd"
COMPANY_TAGLINE="Web Development & Digital Marketing Agency"
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_GSTIN=
